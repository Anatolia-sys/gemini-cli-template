# ===========================================
# .geminiignore - Gemini CLI 除外設定
# ===========================================
# .gitignore と同じ構文で記述します。
# Gemini CLI がコンテキストに含めないファイル・フォルダを指定します。
#
# 主な除外対象:
#   - 機密情報（APIキー、シークレット）
#   - 依存パッケージ（node_modules 等）
#   - ビルド成果物
#   - ログ・キャッシュ
#   - 大容量バイナリファイル
# ===========================================

# -------------------------------------------
# 機密情報・環境設定
# -------------------------------------------
.env
.env.*
*.pem
*.key
*.cert
secrets/
credentials/

# -------------------------------------------
# 依存パッケージ
# -------------------------------------------
node_modules/
vendor/
.venv/
venv/
__pypackages__/
packages/

# -------------------------------------------
# ビルド成果物・コンパイル出力
# -------------------------------------------
dist/
build/
out/
target/
bin/
obj/
*.min.js
*.min.css
*.map

# -------------------------------------------
# ログ・キャッシュ・一時ファイル
# -------------------------------------------
*.log
logs/
tmp/
temp/
.cache/
.tmp/

# -------------------------------------------
# IDE・エディタ設定
# -------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -------------------------------------------
# テストカバレッジ・レポート
# -------------------------------------------
coverage/
.nyc_output/
htmlcov/
*.lcov

# -------------------------------------------
# パッケージマネージャのロックファイル
# （必要に応じてコメントアウトを解除）
# -------------------------------------------
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# Pipfile.lock
# poetry.lock
# Gemfile.lock
# go.sum

# -------------------------------------------
# バイナリ・メディアファイル
# -------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar.gz
*.rar
*.7z
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.mp4
*.mp3
*.pdf

# -------------------------------------------
# データベース
# -------------------------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------------------------
# Docker
# -------------------------------------------
# Dockerfile と docker-compose.yml は含める
*.tar

# -------------------------------------------
# その他
# -------------------------------------------
# 難読化されたコード
*.obfuscated.*

# 生成されたドキュメント（ソースは含める）
docs/_build/
site/
